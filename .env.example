# Copy to .env (gitignored). Values are read by the scripts and never printed.
OPENAI_API_KEY=
# Dataset passwords: only needed to fetch the restricted datasets (fetch_and_select.py / setup_vllm.sh with them);
# not for the code datasets, reading or analysis. Published in each dataset's own README (Model Organisms for EM;
# Wang et al. persona features).
EM_MO_PASSWORD=
EM_WANG_PASSWORD=
# Where data, readings and caches live (default: ./em_raw, gitignored).
# EM_RAW_DIR=/path/outside/the/repo
